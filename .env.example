# XL👀k — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file — it's gitignored

# ─── Database ─────────────────────────────────────────
# PostgreSQL (Neon Cloud DB — recommended for Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-strong-random-secret-minimum-64-characters"
JWT_EXPIRES_IN="7d"

# ─── AI Analysis ──────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# ─── Security APIs ────────────────────────────────────
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# Google Safe Browsing: https://console.cloud.google.com
GOOGLE_SAFE_BROWSING_API_KEY="your-google-safe-browsing-key"

# ─── Runtime ──────────────────────────────────────────
NODE_ENV="development"
